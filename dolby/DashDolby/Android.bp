package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DashDolby",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibMainSwitchPreference",
    ],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
}
