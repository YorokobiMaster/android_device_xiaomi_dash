+    private void updateDeviceBrightnessCaps(int state, float ambientLux) {
+        if (!mDeviceBrightnessPolicyConfigured) return;
+        DeviceBrightnessPolicy.Limits limits = DeviceBrightnessPolicy.Limits.UNAVAILABLE;
+        if (mDeviceBrightnessPolicy != null) {
+            try {
+                mDeviceBrightnessPolicy.update(state == Display.STATE_ON,
+                        mAutomaticBrightnessStrategy.isAutoBrightnessEnabled(), ambientLux);
+                limits = mDeviceBrightnessPolicy.getLimits();
+            } catch (RuntimeException e) {
+                Slog.e(mTag, "Device brightness policy failed; HBM disabled", e);
+                stopDeviceBrightnessPolicy();
+            }
+        }
+        float normal = mBrightnessRangeController.getNormalBrightnessMax();
+        float thermal = deviceCapFromNits(limits.thermalMaxNits(), normal);
+        float sdr = deviceCapFromNits(limits.sdrMaxNits(), normal);
+        float hdr = deviceCapFromNits(limits.hdrMaxNits(), normal);
+        if (!limits.highBrightnessAllowed()) {
+            sdr = Math.min(sdr, normal);
+            hdr = Math.min(hdr, normal);
+        }
+        mBrightnessClamperController.setDeviceBrightnessCaps(thermal, sdr, hdr);
+    }
+
+    private void stopDeviceBrightnessPolicy() {
+        DeviceBrightnessPolicy policy = mDeviceBrightnessPolicy;
+        mDeviceBrightnessPolicy = null;
+        if (policy == null) return;
+        try {
+            policy.stop();
+        } catch (RuntimeException e) {
+            Slog.e(mTag, "Device brightness policy cleanup failed", e);
+        }
+    }
+
+    private float deviceCapFromNits(float nits, float normal) {
+        if (nits == Float.POSITIVE_INFINITY) return PowerManager.BRIGHTNESS_MAX;
+        if (!Float.isFinite(nits) || nits < 0) return normal;
+        float cap = mDisplayBrightnessController.getBrightnessFromNits(nits);
+        return BrightnessUtils.isValidBrightnessValue(cap) ? cap : normal;
+    }
+
