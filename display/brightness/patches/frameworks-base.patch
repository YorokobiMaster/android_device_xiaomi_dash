+                .setBrightnessReason(BrightnessReason.REASON_BOOST).build();
+        DisplayBrightnessState state = mClamperController.clamp(input, mMockRequest,
+                1.0f, false, STATE_ON);
+        assertEquals(0.3f, state.getBrightness(), FLOAT_TOLERANCE);
+        assertEquals(BrightnessReason.REASON_BOOST, state.getBrightnessReason().getReason());
+        // DashFod calls vendor extCmd; it does not request DPC REASON_BOOST.
+    }
