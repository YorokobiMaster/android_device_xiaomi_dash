+package com.android.server.display;
+
+/**
+ * Device ambient estimator, called only on the automatic brightness handler.
+ * The controller retains sensor ownership, the evaluation timer, mapping and short-term model.
+ * Implementations must not subscribe in their constructor. All times here are uptime millis.
+ * @hide
+ */
+public interface DeviceAmbientPolicy {
+    void start(long uptimeMillis);
+    void stop();
+    void onPrimarySample(long uptimeMillis, float lux);
+    Evaluation evaluate(long uptimeMillis, float currentLux);
+    /** Called once per animation decision; HDR needs a separately validated device contract. */
+    boolean useFastRamp(float currentBrightness, float targetBrightness,
+            float currentNits, float targetNits, boolean hdr);
+
+    /** NaN lux retains the current estimate; MAX_VALUE means no scheduled evaluation. */
+    final class Evaluation {
+        public final float lux;
+        public final long nextEvaluationUptimeMillis;
+
+        public Evaluation(float lux, long nextEvaluationUptimeMillis) {
+            this.lux = lux;
+            this.nextEvaluationUptimeMillis = nextEvaluationUptimeMillis;
+        }
+    }
+}
