+        DisplayBrightnessState state = mClamperController.clamp(input, mMockRequest,
+                0.4f, true, STATE_ON);
+        assertEquals(0.9f, state.getHdrBrightness(), FLOAT_TOLERANCE);
+        assertThat(state.isSlowChange()).isTrue();
+    }
