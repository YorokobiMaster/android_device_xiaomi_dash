+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display;
+
+import java.io.PrintWriter;
+
+/** Device thermal/content inputs; never writes display brightness itself.
+ *
+ * Implementations have a public (Context, Handler, Runnable onChanged) constructor. All methods
+ * run on the display handler; blocking input work belongs on an implementation-owned worker.
+ * The constructor must not subscribe. onChanged requests a DPC evaluation on the display handler.
+ */
+public interface DeviceBrightnessPolicy {
+    void update(boolean interactive, boolean automatic, float ambientLux,
+            boolean hdrLayerPresent);
+    Limits getLimits();
+    void stop();
+    void dump(PrintWriter writer);
+
+    /** Thermal/SDR limits are nits; the HDR limit is framework brightness. Infinity is
+     * explicitly unbounded and NaN is unavailable. HBM authorization remains owned by
+     * HighBrightnessModeController. */
+    record Limits(float thermalMaxNits, float sdrMaxNits, float hdrMaxBrightness) {
+        public static final Limits UNAVAILABLE =
+                new Limits(Float.NaN, Float.NaN, Float.NaN);
+    }
+}
