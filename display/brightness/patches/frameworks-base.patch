+    private static final class DecliningPolicy implements DeviceBrightnessRampPolicy {
+        private final float mInitialRate;
+        private int mCalls;
+
+        DecliningPolicy(float initialRate) {
+            mInitialRate = initialRate;
+        }
+
+        @Override
+        public float getRate(String propertyName, float transitionStartLinearBrightness,
+                float currentLinearBrightness, float targetLinearBrightness) {
+            return mCalls++ == 0 ? mInitialRate : Float.NaN;
+        }
+    }
+
+    private static final class CountingPolicy implements DeviceBrightnessRampPolicy {
+        private final float mRate;
+        private int mCalls;
+
+        CountingPolicy(float rate) {
+            mRate = rate;
+        }
+
+        @Override
+        public float getRate(String propertyName, float transitionStartLinearBrightness,
+                float currentLinearBrightness, float targetLinearBrightness) {
+            mCalls++;
+            return mRate;
+        }
+    }
