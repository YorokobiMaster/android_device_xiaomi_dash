+        }
+    }
+
+    public boolean useDeviceFastRamp(float currentBrightness, float targetBrightness,
+            float currentNits, float targetNits, boolean hdr) {
+        if (!mDeviceAmbientPolicyActive) return false;
+        try {
+            return mDeviceAmbientPolicy.useFastRamp(currentBrightness, targetBrightness,
+                    currentNits, targetNits, hdr);
+        } catch (RuntimeException e) {
+            failDeviceAmbientPolicy(e);
+            return false;
+        }
+    }
+
+    private void updateDeviceAmbientPolicyState() {
+        final boolean active = mDeviceAmbientPolicy != null && !mDeviceAmbientPolicyFailed
+                && mLightSensorEnabled && !mDeviceOneShotRequested
+                && getMode() == AUTO_BRIGHTNESS_MODE_DEFAULT
+                && mDisplayState == Display.STATE_ON && isInteractivePolicy(mDisplayPolicy);
+        if (active == mDeviceAmbientPolicyActive) return;
+        mDeviceAmbientPolicyActive = active;
+        resetAmbientEstimator();
+        try {
+            if (active) {
+                mDeviceAmbientPolicy.start(mClock.uptimeMillis());
+            } else {
+                mDeviceAmbientPolicy.stop();
+            }
+        } catch (RuntimeException e) {
+            failDeviceAmbientPolicy(e);
+        }
+    }
+
+    private void resetAmbientEstimator() {
+        mHandler.removeMessages(MSG_UPDATE_AMBIENT_LUX);
+        mAmbientLightRingBuffer.clear();
+        mAmbientLuxValid = false;
+        mRecentLightSamples = 0;
+        mLastPrimaryEventTime = Long.MIN_VALUE;
+        mLightSensorSessionStart = mClock.getSensorEventScaleTime();
+        // A new listener rejects queued callbacks from the previous estimator session.
+        mLightSensorGeneration++;
+        if (mLightSensorEnabled) {
+            mSensorManager.unregisterListener(mLightSensorListener);
+            mLightSensorListener = createLightSensorListener(mLightSensorGeneration);
+            mSensorManager.registerListener(mLightSensorListener, mLightSensor,
+                    mCurrentLightSensorRate * 1000, mHandler);
+        }
+    }
+
+    private void failDeviceAmbientPolicy(RuntimeException failure) {
+        Slog.e(TAG, "Device ambient estimator failed; waiting for fresh primary ALS", failure);
+        mDeviceAmbientPolicyFailed = true;
+        mDeviceAmbientPolicyActive = false;
+        try {
+            mDeviceAmbientPolicy.stop();
+        } catch (RuntimeException cleanupFailure) {
+            Slog.e(TAG, "Device ambient estimator cleanup failed", cleanupFailure);
+        }
+        resetAmbientEstimator();
+    }
+
+    private void evaluateDeviceAmbientLux() {
+        mHandler.removeMessages(MSG_UPDATE_AMBIENT_LUX);
+        final long now = mClock.uptimeMillis();
+        final long warmedUp = mLightSensorEnableTime + mLightSensorWarmUpTimeConfig;
+        if (now < warmedUp) {
+            mHandler.sendEmptyMessageAtTime(MSG_UPDATE_AMBIENT_LUX, warmedUp);
+            return;
+        }
+        try {
+            final DeviceAmbientPolicy.Evaluation evaluation = mDeviceAmbientPolicy.evaluate(
+                    now, mAmbientLuxValid ? mAmbientLux : Float.NaN);
+            if (evaluation == null || (!Float.isNaN(evaluation.lux)
+                    && (!Float.isFinite(evaluation.lux) || evaluation.lux < 0))) {
+                throw new IllegalArgumentException("Invalid device ambient estimate");
+            }
+            if (!Float.isNaN(evaluation.lux)) {
+                mPreThresholdLux = mAmbientLuxValid ? mAmbientLux : INVALID_LUX;
+                setAmbientLux(evaluation.lux);
+                mAmbientLuxValid = true;
+                updateAutoBrightness(true /* sendUpdate */, false /* isManuallySet */);
+            }
+            if (evaluation.nextEvaluationUptimeMillis != Long.MAX_VALUE) {
+                mHandler.sendEmptyMessageAtTime(MSG_UPDATE_AMBIENT_LUX,
+                        evaluation.nextEvaluationUptimeMillis > now
+                                ? evaluation.nextEvaluationUptimeMillis
+                                : now + mNormalLightSensorRate);
+            }
+        } catch (RuntimeException e) {
+            failDeviceAmbientPolicy(e);
+        }
     }
 
