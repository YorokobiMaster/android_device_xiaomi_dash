+    public void testDeviceCapsPreserveTighterNativeThermalAndHdrLimit() {
+        doAnswer(invocation -> {
+            DisplayBrightnessState.Builder builder = invocation.getArgument(1);
+            builder.setMaxBrightness(0.2f);
+            builder.setBrightness(0.2f);
+            builder.setHdrBrightness(0.15f);
+            builder.setBrightnessMaxReason(BrightnessInfo.BRIGHTNESS_MAX_REASON_THERMAL);
+            return null;
+        }).when(mMockModifier).apply(any(), any());
+        mClamperController.setDeviceBrightnessCaps(0.6f, 0.5f, 0.5f);
+        DisplayBrightnessState state = mClamperController.clamp(mDisplayBrightnessState,
+                mMockRequest, 0.8f, true, STATE_ON);
+        assertEquals(0.2f, state.getBrightness(), FLOAT_TOLERANCE);
+        assertEquals(0.15f, state.getHdrBrightness(), FLOAT_TOLERANCE);
+        assertEquals(0.2f, state.getMaxBrightness(), FLOAT_TOLERANCE);
+        assertEquals(BrightnessInfo.BRIGHTNESS_MAX_REASON_THERMAL,
+                state.getBrightnessMaxReason());
+    }
