package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DashRefreshRate",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
}

java_test_host {
    name: "DashRefreshRateHostTest",
    srcs: [
        "src/org/lineageos/dashrefreshrate/RefreshRatePolicy.java",
        "tests/src/**/*.java",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
    static_libs: ["junit"],
}
