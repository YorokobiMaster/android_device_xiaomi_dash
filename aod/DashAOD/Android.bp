package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DashAOD",
    srcs: [
        "src/**/*.aidl",
        "src/**/*.java",
    ],
    libs: ["SystemUIPluginLib"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
}
