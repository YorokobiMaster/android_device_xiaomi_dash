package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "dash-fod",
    srcs: [
        "src/me/sandai/dashfod/DashFodService.java",
        "src/me/sandai/dashfod/FodController.java",
    ],
    libs: ["services.core"],
    static_libs: ["vendor.xiaomi.hardware.fingerprintextension-V1-java"],
    platform_apis: true,
    system_ext_specific: true,
    installable: true,
}

android_app {
    name: "DashFod",
    srcs: [
        "src/me/sandai/dashfod/DashFodApplication.java",
        "src/me/sandai/dashfod/PinLayoutController.java",
        "src/me/sandai/dashfod/PinLayoutPlugin.java",
    ],
    libs: ["SystemUIPluginLib"],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
}
