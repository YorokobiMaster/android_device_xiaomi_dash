package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DashFod",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: ["vendor.xiaomi.hardware.fingerprintextension-V1-java"],
}

java_test_host {
    name: "DashFodHostTest",
    srcs: [
        "src/org/lineageos/dashfod/FodController.java",
        "src/org/lineageos/dashfod/KeyguardAuthGate.java",
        "tests/src/**/*.java",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
    static_libs: ["junit"],
}
