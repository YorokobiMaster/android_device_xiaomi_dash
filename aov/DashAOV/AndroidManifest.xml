<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="me.sandai.dashaov">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="com.android.systemui.permission.PLUGIN" />

    <application
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:label="@string/app_name">

        <activity
            android:name=".SmartAodSettingsActivity"
            android:exported="true"
            android:icon="@drawable/ic_smart_aod"
            android:label="@string/settings_title"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="category_lock_display" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_smart_aod" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-10" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_summary" />
        </activity>

        <service
            android:name=".DashAovPlugin"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.android.systemui.action.PLUGIN_DOZE" />
            </intent-filter>
        </service>

        <service
            android:name=".DashAovBridgeService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:process=":aov" />

        <service
            android:name=".SmartAodTileService"
            android:directBootAware="true"
            android:exported="true"
            android:icon="@drawable/ic_smart_aod"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
