soong_namespace {
}

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DashDt2w",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    jni_libs: ["libdashdt2w_jni"],
    required: ["libdashdt2w_jni"],
}

cc_library_shared {
    name: "libdashdt2w_jni",
    srcs: ["jni/DashDt2wJni.cpp"],
    shared_libs: ["liblog"],
    header_libs: ["jni_headers"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    system_ext_specific: true,
}
