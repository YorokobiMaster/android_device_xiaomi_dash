+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.power;
+
+/** Optional device power events, internal to system_server. Not a Power HAL replacement. */
+public abstract class DevicePowerManagerInternal {
+    /** Callbacks run under the power lock: implementations must only enqueue, never perform IPC. */
+    public interface Listener {
+        void onStateChanged(boolean interactive, boolean launchBoostDisabled);
+        void onLaunch(boolean enabled);
+        void onFling(int displayId, int durationMs);
+    }
+
+    /** Seeds current policy before returning, without replaying an earlier launch or fling. */
+    public abstract void setListener(Listener listener);
+
+    /** Called only by the resolved gesture source, not generic INTERACTION producers. */
+    public abstract void onFling(int displayId, int durationMs);
+}
