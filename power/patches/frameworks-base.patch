+    @Test
+    public void testDevicePowerEvents_preserveLaunchFilterAndEnd() {
+        createService();
+        startSystem();
+        final DevicePowerManagerInternal.Listener listener =
+                mock(DevicePowerManagerInternal.Listener.class);
+        mService.getDevicePowerServiceInstance().setListener(listener);
+        when(mBatterySaverControllerMock.isLaunchBoostDisabled()).thenReturn(true);
+        mService.getBinderServiceInstance().setPowerMode(Mode.LAUNCH, true);
+        mService.getBinderServiceInstance().setPowerMode(Mode.LAUNCH, false);
+        verify(listener, never()).onLaunch(true);
