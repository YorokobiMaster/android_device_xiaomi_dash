+        mService.getBinderServiceInstance().setPowerMode(Mode.LOW_POWER, false);
+        source.onFling(0, 200);
+        verify(listener, never()).onFling(0, 200);
+        verify(listener, atLeastOnce()).onStateChanged(true, true);
+    }
