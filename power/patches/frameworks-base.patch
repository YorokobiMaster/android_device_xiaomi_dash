+    @Test
+    public void testDevicePowerEvents_exactAdaptivePolicyAndResolvedFling() {
+        createService();
+        startSystem();
+        final DevicePowerManagerInternal source = mService.getDevicePowerServiceInstance();
+        final DevicePowerManagerInternal.Listener listener =
+                mock(DevicePowerManagerInternal.Listener.class);
+        source.setListener(listener);
+        mService.getBinderServiceInstance().setPowerBoost(Boost.INTERACTION, 100);
+        verify(listener, never()).onFling(anyInt(), anyInt());
+        source.onFling(0, 100);
+        verify(listener).onFling(0, 100);
+        // Advertised saver false is independent of the active adaptive launch policy.
