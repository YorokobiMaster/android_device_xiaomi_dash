<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- VoLTE available -->
    <bool name="config_device_volte_available">true</bool>

    <!-- 5G modes supported by the retained MediaTek radio stack -->
    <bool name="config_telephony5gStandalone">true</bool>
    <bool name="config_telephony5gNonStandalone">true</bool>

    <!-- SIM hot swap -->
    <bool name="config_hotswapCapable">true</bool>

    <!-- Display cutout / camera hole. Copied verbatim from HyperOS
         DevicesAndroidOverlay.apk: a 66px-wide rectangle spanning from
         the top edge down to 152px, matching status_bar_height. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">
        M 0,0 H -33 V 152 H 33 V 0 H 0 Z
    </string>

    <!-- Display shape -->
    <string name="config_mainDisplayShape" translatable="false">M20 0h1040s20 0 20 20v2360s0 20 -20 20h-1040s-20 0 -20 -20v-2360s0 -20 20 -20</string>

    <!-- UDFPS Sensor Properties: [sensorLocationX, sensorLocationY, sensorRadius] -->
    <integer-array name="config_udfps_sensor_props" translatable="false">
        <item>640</item>
        <item>2124</item>
        <item>79</item>
    </integer-array>

    <!-- Always-on display. The panel driver provides doze/AOD support
         (doze_enable/doze_disable, AOD brightness tables); present it
         through SystemUI's doze service. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>

    <!-- Whether device supports double tap to wake -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- DashWake owns pickup wake and its setting; do not expose the Doze gesture. -->
    <bool name="config_dozePulsePickup">false</bool>

    <!-- DashFod arms the fingerprint extension only after Doze is visible. -->
    <bool name="config_screen_off_udfps_enabled">true</bool>

    <!-- Default the screen-off UDFPS switch on: a fresh flash should have
         working AOD fingerprint out of the box. AmbientDisplayConfiguration
         and the Settings toggle both resolve an unset secure key from this,
         and DashFod falls back to it too. -->
    <bool name="config_screen_off_udfps_default_on">true</bool>

    <!-- Auto-brightness response tuning. The retained MediaTek
         FrameworkResOverlayExt supplies the stock 17-level curve
         (128..18432 lux -> backlight 8..255), but nothing set debounce
         or lux hysteresis, so the AOSP controller fell back to 4s/8s
         debounce with empty thresholds: slow to react, yet jumpy on
         sensor noise. Threshold levels below reuse the octave steps of
         that curve. -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">1000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">2000</integer>

    <integer-array name="config_ambientThresholdLevels" translatable="false">
        <item>128</item>
        <item>256</item>
        <item>512</item>
        <item>1024</item>
        <item>2048</item>
        <item>4096</item>
        <item>8192</item>
    </integer-array>

    <!-- Hysteresis constraints in tenths of a percent (1000 = 100%).
         Brightening: eager in the dark, lazy near HBM territory. -->
    <integer-array name="config_ambientBrighteningThresholds" translatable="false">
        <item>100</item>
        <item>200</item>
        <item>300</item>
        <item>300</item>
        <item>300</item>
        <item>400</item>
        <item>600</item>
        <item>1000</item>
    </integer-array>

    <!-- Darkening: below 256 lux ambient light must drop 80% before
         the screen dims; above that, 50%. This is the restraint. -->
    <integer-array name="config_ambientDarkeningThresholds" translatable="false">
        <item>800</item>
        <item>800</item>
        <item>500</item>
        <item>500</item>
        <item>500</item>
        <item>500</item>
        <item>500</item>
        <item>500</item>
    </integer-array>
</resources>
