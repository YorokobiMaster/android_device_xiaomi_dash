<com.android.systemui.shade.NotificationPanelView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:systemui="http://schemas.android.com/apk/prv/res/com.android.systemui"
    android:id="@*com.android.systemui:id/notification_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.android.systemui.deviceentry.ui.view.UdfpsAccessibilityOverlayOverlappingTouchHandlingView
        android:id="@*com.android.systemui:id/keyguard_long_press"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include layout="@*com.android.systemui:layout/status_bar_expanded_plugin_frame"/>

    <com.android.systemui.shade.NotificationsQuickSettingsContainer
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="@*com.android.systemui:integer/notification_panel_layout_gravity"
        android:id="@*com.android.systemui:id/notification_container_parent"
        android:clipToPadding="false"
        android:clipChildren="false">

        <include layout="@*com.android.systemui:layout/dock_info_overlay"/>

        <FrameLayout
            android:id="@*com.android.systemui:id/qs_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginHorizontal="@*com.android.systemui:dimen/notification_panel_margin_horizontal"
            systemui:viewType="com.android.systemui.plugins.qs.QS"
            systemui:layout_constraintStart_toStartOf="parent"
            systemui:layout_constraintEnd_toEndOf="parent"
            systemui:layout_constraintTop_toTopOf="parent"
            systemui:layout_constraintBottom_toBottomOf="parent"
        />

        <androidx.constraintlayout.widget.Guideline
            android:id="@*com.android.systemui:id/qs_edge_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            systemui:layout_constraintGuide_percent="0.5"
            android:orientation="vertical"/>

        <!-- This layout should always include a version of
             NotificationStackScrollLayout, as it is expected from
             NotificationPanelViewController. -->
        <include layout="@*com.android.systemui:layout/notification_stack_scroll_layout" />

        <include layout="@*com.android.systemui:layout/photo_preview_overlay" />

        <include
            layout="@*com.android.systemui:layout/keyguard_status_bar"
            android:visibility="invisible" />

        <Button
            android:id="@*com.android.systemui:id/report_rejected_touch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@*com.android.systemui:dimen/status_bar_header_height_keyguard"
            android:text="@*com.android.systemui:string/report_rejected_touch"
            android:visibility="gone" />
        <com.android.systemui.statusbar.phone.TapAgainView
            android:id="@*com.android.systemui:id/shade_falsing_tap_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            systemui:layout_constraintLeft_toLeftOf="parent"
            systemui:layout_constraintRight_toRightOf="parent"
            systemui:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="16dp"
            android:minHeight="44dp"
            android:elevation="4dp"
            android:background="@*com.android.systemui:drawable/rounded_bg_full"
            android:gravity="center"
            android:text="@*com.android.systemui:string/tap_again"
            android:visibility="gone"
        />
    </com.android.systemui.shade.NotificationsQuickSettingsContainer>

    <include layout="@*com.android.systemui:layout/dock_info_bottom_area_overlay" />

    <include
        layout="@*com.android.systemui:layout/keyguard_bottom_area"
        android:visibility="gone" />

    <include
        android:id="@*com.android.systemui:id/keyguard_charging_button"
        layout="@*com.android.systemui:layout/keyguard_settings_popup_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="@*com.android.systemui:dimen/keyguard_affordance_vertical_offset"
        android:layout_marginHorizontal="@*com.android.systemui:dimen/keyguard_affordance_horizontal_offset"
        android:visibility="gone"
        />
</com.android.systemui.shade.NotificationPanelView>
