<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:clipChildren="true"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <androidx.viewpager.widget.ViewPager
        android:id="@*org.lineageos.lineageparts:id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="@*org.lineageos.lineageparts:dimen/color_mode_preview_height"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <FrameLayout
            android:id="@*org.lineageos.lineageparts:id/arrow_previous"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingLeft="24dp"
            android:layout_gravity="center_vertical|left"
            android:contentDescription="@*org.lineageos.lineageparts:string/back">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@*org.lineageos.lineageparts:drawable/ic_color_arrow_left_lt"/>
        </FrameLayout>

        <LinearLayout
            android:id="@*org.lineageos.lineageparts:id/viewGroup"
            android:layout_width="fill_parent"
            android:layout_height="48dp"
            android:gravity="center"/>

        <FrameLayout
            android:id="@*org.lineageos.lineageparts:id/arrow_next"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingRight="24dp"
            android:layout_gravity="center_vertical|right"
            android:contentDescription="@*org.lineageos.lineageparts:string/next">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@*org.lineageos.lineageparts:drawable/ic_color_arrow_right_lt"/>
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
