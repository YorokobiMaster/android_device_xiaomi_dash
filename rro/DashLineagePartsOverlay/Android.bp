runtime_resource_overlay {
    name: "DashLineagePartsOverlay",
    certificate: "platform",
    system_ext_specific: true,
    resource_libs: ["LineageParts"],
    // Keep overlay IDs distinct from target 0x7f IDs and nonzero for idmap2.
    aaptflags: ["--package-id", "0x7e", "--allow-reserved-package-id"],
}
