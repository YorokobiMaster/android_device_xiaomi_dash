package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DashEyeCare",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    optimize: {
        enabled: true,
    },
}
