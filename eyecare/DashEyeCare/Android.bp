package { default_applicable_licenses: ["Android-Apache-2.0"] }

android_app {
    name: "DashEyeCare",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    optimize: { enabled: true },
}
java_test_host {
    name: "DashEyeCareHostTest",
    srcs: ["src/me/sandai/dasheyecare/NightLightLevel.java", "tests/**/*.java"],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
    test_options: { unit_test: true },
}
