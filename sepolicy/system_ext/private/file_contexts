/(system_ext|system/system_ext)/bin/hw/dash-vibrator-adapter  u:object_r:dash_vibrator_adapter_exec:s0
/(system_ext|system/system_ext)/bin/hw/dash-livedisplay  u:object_r:dash_livedisplay_exec:s0
/(system_ext|system/system_ext)/bin/hw/dash-health  u:object_r:dash_health_exec:s0
/(system_ext|system/system_ext)/bin/hw/dash-audio-parameter-parser  u:object_r:audioserver_exec:s0
