# The retained stock fstab mounts mi_ext directories over Lineage-owned
# framework partitions. Remove every mi_ext-backed overlay before
# PackageManager scans them, then detach the source partition so later stock
# init actions cannot recreate those mounts.
on post-fs
    umount /system_ext/etc/permissions
    umount /system/etc/permissions
    umount /system/etc/sysconfig
    umount /system/priv-app
    umount /system/app
    umount /product/etc/security
    umount /product/etc/preferred-apps
    umount /product/etc/precust_theme
    umount /product/etc/permissions
    umount /product/etc/sysconfig
    umount /product/data-app
    umount /product/opcust
    umount /product/media
    umount /product/framework
    umount /product/bin
    umount /product/lib64
    umount /product/lib
    umount /product/priv-app
    umount /product/app
    umount /product/overlay
    umount /product/usr
    umount /mi_ext
    umount /mnt/vendor/mi_ext

# The retained Xiaomi displayfeature HAL opens this stock ueventd path, while
# the AOSP ueventd configuration exposes the same mi_display cdev at
# /dev/disp_feature. Use a hard link so the stock pathname resolves to that
# same already-labelled device node.
service dash-displayfeature-compat /system_ext/bin/dash-displayfeature-compat
    class core
    user root
    group root graphics
    disabled
    oneshot

on early-boot
    mkdir /dev/mi_display 0755 root graphics
    wait /dev/disp_feature 5
    exec_start dash-displayfeature-compat
    chown root graphics /dev/mi_display/disp_feature
    chmod 0666 /dev/mi_display/disp_feature

# AW21024 camera ring LED register access for DashLedService (priv_app
# domain). The world-writable Unix mode is gated by SELinux: the nodes carry
# the stock vendor_sysfs_led_file label and only priv_app (plus stock
# mtk_hal_light/system_app) may write them. Runs as a service so the result
# is observable through init.svc.dash-led-perms; boot_completed ordering also
# guarantees we win against the stock odm init_leds.rc "on boot" block, which
# re-chowns these nodes to system:system 0664.
service dash-led-perms /system/bin/chmod 0666 /sys/class/leds/aw21024_led/hwen /sys/class/leds/aw21024_led/run /sys/class/leds/aw21024_led/reg
    class core
    user root
    group root
    disabled
    oneshot

on property:sys.boot_completed=1
    start dash-led-perms
